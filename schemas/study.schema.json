{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curioler.org/schemas/study.schema.json",
  "title": "Curioler Research Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pmid",
    "doi",
    "title",
    "year",
    "journal",
    "authors",
    "study_type",
    "participants",
    "age_range",
    "diagnosis",
    "intervention",
    "duration",
    "primary_outcomes",
    "secondary_outcomes",
    "limitations",
    "clinical_implications",
    "abstract",
    "conclusion",
    "mesh_terms",
    "keywords",
    "source_url",
    "extraction_confidence",
    "created_at",
    "last_updated"
  ],
  "properties": {
    "pmid": { "type": "string", "pattern": "^[0-9]+$" },
    "doi": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "year": { "type": ["integer", "null"], "minimum": 1800 },
    "journal": { "type": ["string", "null"] },
    "authors": { "type": "array", "items": { "type": "string" } },
    "study_type": { "type": ["string", "null"] },
    "participants": { "type": ["integer", "string", "null"] },
    "age_range": { "type": ["string", "null"] },
    "diagnosis": { "type": ["string", "null"] },
    "intervention": { "type": ["string", "null"] },
    "duration": { "type": ["string", "null"] },
    "primary_outcomes": { "type": "array", "items": { "type": "string" } },
    "secondary_outcomes": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "clinical_implications": { "type": ["string", "null"] },
    "abstract": { "type": ["string", "null"] },
    "conclusion": { "type": ["string", "null"] },
    "mesh_terms": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "source_url": { "type": "string", "pattern": "^https://pubmed.ncbi.nlm.nih.gov/[0-9]+/?$" },
    "extraction_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string" },
    "last_updated": { "type": "string" }
  }
}
